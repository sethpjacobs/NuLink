<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>nulink</AssemblyName>
        <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
        <PackageId>NuLink</PackageId>
        <Version>0.2.0</Version>
        <RepositoryUrl>https://github.com/nwheels-io/NuLink</RepositoryUrl>
        <PackageProjectUrl>https://nwheels-io.github.io/NuLink/</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>The missing LINK feature of NuGet: develop &amp; test packages as if they were part of the main project. Now with Central Package Management (Directory.Packages.props) support!</Description>
        <Authors>Felix Berman, Seth Jacobs</Authors>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>nulink</ToolCommandName>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
      <PackageReference Include="Buildalyzer" Version="7.0.2" />
      <PackageReference Include="Murphy.SymbolicLink" Version="1.0.0" />
    </ItemGroup>

</Project>
